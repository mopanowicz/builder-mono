#!/usr/bin/env bash
set -euo pipefail

SRC_DIR="/tmp/src"
DEPLOY_DIR="${DEPLOY_DIR:-/opt/app-root/src}"

mkdir -p "${DEPLOY_DIR}"
cd "${SRC_DIR}"

if [[ -f "pom.xml" ]]; then
    echo "---> Detected Maven project (pom.xml)"
    if [[ -f "./mvnw" ]]; then
        echo "---> Using Maven Wrapper (./mvnw)"
        chmod +x ./mvnw
        MVN_CMD="./mvnw"
    else
        echo "---> Using system Maven (mvn)"
        MVN_CMD="mvn"
    fi

    if grep -Eq 'quarkus-maven-plugin|quarkus\.platform|io\.quarkus' pom.xml; then
        echo "---> Detected Quarkus Maven project"
        MAVEN_ARGS="${MAVEN_ARGS:-clean package --no-transfer-progress -Dmaven.javadoc.skip=true} -Dquarkus.package.jar.type=uber-jar"
    else
        MAVEN_ARGS="${MAVEN_ARGS:-clean package --no-transfer-progress -Dmaven.javadoc.skip=true}"
    fi

    echo "---> Running: ${MVN_CMD} ${MAVEN_ARGS}"
    ${MVN_CMD} ${MAVEN_ARGS}

    JAR_FILE=$(find target -maxdepth 1 -type f \( -name "*-runner.jar" -o -name "*.jar" \) ! -name "*-sources.jar" ! -name "*-javadoc.jar" ! -name "original-*.jar" ! -name "*-plain.jar" | head -n 1)
    if [[ -z "${JAR_FILE}" ]]; then
        echo "ERROR: No runnable JAR found in target/" >&2
        exit 1
    fi
    cp -v "${JAR_FILE}" "${DEPLOY_DIR}/app.jar"

elif [[ -f "build.gradle" || -f "build.gradle.kts" ]]; then
    echo "---> Detected Gradle project"
    if [[ -f "./gradlew" ]]; then
        echo "---> Using Gradle Wrapper (./gradlew)"
        chmod +x ./gradlew
        GRADLE_CMD="./gradlew"
    else
        echo "---> Using system Gradle (gradle)"
        GRADLE_CMD="gradle"
    fi

    if grep -Eq 'io\.quarkus|quarkus' build.gradle* 2>/dev/null || grep -Eq 'io\.quarkus|quarkus' settings.gradle 2>/dev/null; then
        echo "---> Detected Quarkus Gradle project"
        GRADLE_ARGS="${GRADLE_ARGS:-build -x test --no-daemon} -Dquarkus.package.jar.type=uber-jar"
    else
        GRADLE_ARGS="${GRADLE_ARGS:-assemble -x test --no-daemon}"
    fi

    echo "---> Running: ${GRADLE_CMD} ${GRADLE_ARGS}"
    ${GRADLE_CMD} ${GRADLE_ARGS}

    JAR_FILE=$(find build -maxdepth 3 -type f -name "*-runner.jar" ! -name "*-plain.jar" ! -name "*-sources.jar" ! -name "*-javadoc.jar" | head -n 1)
    if [[ -z "${JAR_FILE}" ]]; then
        JAR_FILE=$(find build/libs -maxdepth 1 -type f \( -name "*.jar" \) ! -name "*-plain.jar" ! -name "*-sources.jar" ! -name "*-javadoc.jar" ! -name "original-*.jar" | head -n 1)
    fi
    if [[ -z "${JAR_FILE}" ]]; then
        echo "ERROR: No runnable JAR found in build/" >&2
        exit 1
    fi
    cp -v "${JAR_FILE}" "${DEPLOY_DIR}/app.jar"

else
    echo "ERROR: Neither pom.xml nor build.gradle(.kts) found in ${SRC_DIR}" >&2
    exit 1
fi

echo "---> Build complete: ${DEPLOY_DIR}/app.jar"
